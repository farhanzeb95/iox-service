# Copy this file to .env and fill in your values.
# The app loads .env automatically on startup (godotenv).

APP_PORT=9001

# Supabase Database (required)
# Project Settings -> Database -> Connection string (URI). Use "Transaction" pooler (port 6543) or direct (5432).
SUPABASE_DATABASE_URL=postgresql://postgres:IonlineExchange2026@db.nwnvxegkhvezzrhrufng.supabase.co:5432/postgres

JWT_SECRET=your-jwt-secret-change-in-production

# Supabase Storage (S3) for uploads (product images, user avatars, identity documents)
# Where to get Access Key & Secret Key:
#   Supabase Dashboard → Project Settings → Storage → S3 Access Keys
#   Generate keys there and copy "Access Key ID" and "Secret Access Key". Use server-side only.
# Endpoint format: https://[project-ref].storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_ENDPOINT=https://nwnvxegkhvezzrhrufng.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY=890deae6930d945979227eac9896a49e
SUPABASE_STORAGE_SECRET_KEY=2158487900f9af8e074bfda06c9c6d2fc04c4a401a5901dc0460f1ade8969080

# Buckets (create these in Dashboard → Storage if needed)
SUPABASE_STORAGE_BUCKET=products
SUPABASE_STORAGE_BUCKET_USERS=users

# Optional: override public URL for each bucket (default is derived from endpoint)
# SUPABASE_STORAGE_PUBLIC_URL=https://[project-ref].supabase.co/storage/v1/object/public/products
# SUPABASE_STORAGE_PUBLIC_URL_USERS=https://[project-ref].supabase.co/storage/v1/object/public/users
